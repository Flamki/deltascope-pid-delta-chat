HOST=127.0.0.1
PORT=8000
TRACE_PATH=artifacts/traces.jsonl
DELTA_MIN_TEXT_LENGTH=3
DELTA_SIMILARITY_THRESHOLD=0.56
DELTA_ALIGNMENT_THRESHOLD=0.35
RETRIEVAL_TOP_K=6
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
# The default local grounded provider requires no key.
ANSWER_PROVIDER=local-extractive-v2
# Recommended hosted provider:
# ANSWER_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-20b
FIREWORKS_INPUT_COST_PER_MILLION=0.07
FIREWORKS_OUTPUT_COST_PER_MILLION=0.30
# Optional hosted/local OpenAI-compatible generative provider:
# ANSWER_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# Optional LibreDWG converter. `make dwg-setup` installs a local ignored copy.
DWG_CONVERTER_PATH=
DWG_CONVERTER_TIMEOUT_SECONDS=60
# Optional production OCR service used by the Vercel split deployment.
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=
OCR_SERVICE_TIMEOUT_SECONDS=120
MAX_FILE_BYTES=
MAX_COMPARISON_BYTES=
